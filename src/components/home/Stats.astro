<section class="stats-bar">
  <div class="container">

    <div class="stat-item">
      <div class="number">
        <span class="counter" data-target="35">0</span>
      </div>
      <span class="label">Years Experience</span>
    </div>

    <div class="divider"></div>
    
    <div class="stat-item">
      <div class="number">
        <span class="counter" data-target="1.9" data-decimals="1">0</span>
        <span class="suffix">MILLION</span>
      </div>
      <span class="label">Feet of Pipe Placed</span>
    </div>

    <div class="divider"></div>

    <div class="stat-item">
      <div class="number">
        <span class="counter" data-target="150">0</span>
        <span class="suffix">+</span>
      </div>
      <span class="label">Projects Completed</span>
    </div>

  </div>
</section>

<style>
  .stats-bar {
    background-color: #f6f6f6;
    color: #1e293b;
    padding: 6rem 0;
    border-bottom: 1px solid rgba(30, 41, 59, 0.05);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
  }

  .number {
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    color: #38bdf8; /* Brand Blue */
    font-family: 'Barlow', sans-serif;
    margin-bottom: 0.5rem;
    
    /* Ensures the number and suffix sit nicely together */
    display: flex;
    align-items: baseline; 
    justify-content: center;
    gap: 0.5rem; 
    flex-wrap: wrap; /* wrap on very small screens if needed */
  }

  /* Optional: Make text suffixes slightly smaller if 'MILLION' is too huge */
  .suffix {
    font-size: 0.6em; /* 60% of the parent 5rem */
    font-weight: 800;
    color: #38bdf8;
  }

  .label {
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #1e293b;
    font-family: 'Barlow', sans-serif;
  }

  .divider {
    width: 1px;
    height: 80px;
    background-color: rgba(30, 41, 59, 0.1);
    margin: 0 2rem;
  }

  /* --- Responsive Design --- */
  @media (max-width: 900px) {
    .number {
      font-size: 4rem;
    }
    .label {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 768px) {
    .stats-bar {
      padding: 4rem 0;
    }

    .container {
      flex-direction: column;
      gap: 3rem;
    }

    .divider {
      width: 60px;
      height: 2px;
      margin: 0;
    }
    
    .number {
      font-size: 3.5rem;
    }
  }
</style>

<script>
  // Function to animate a single counter
  const animateCounter = (el: Element) => {
    const target = parseFloat(el.getAttribute('data-target') || '0');
    const decimals = parseInt(el.getAttribute('data-decimals') || '0');
    const duration = 2000; // Animation duration in ms
    const start = 0;
    const startTime = performance.now();

    const update = (currentTime: number) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);

      // Ease-out quart function for smooth landing
      const ease = 1 - Math.pow(1 - progress, 4);
      
      const currentVal = start + (target - start) * ease;
      
      // Format the number
      el.textContent = currentVal.toFixed(decimals);

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        el.textContent = target.toFixed(decimals); // Ensure final value is exact
      }
    };

    requestAnimationFrame(update);
  };

  // Intersection Observer to trigger animation when visible
  const observerOptions = {
    root: null,
    threshold: 0.5 // Trigger when 50% visible
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        animateCounter(entry.target);
        observer.unobserve(entry.target); // Run only once
      }
    });
  }, observerOptions);

  document.querySelectorAll('.counter').forEach(el => {
    observer.observe(el);
  });
</script>