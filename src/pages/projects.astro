---
import Layout from '../layouts/Layout.astro';

/* Common Components */
import Footer from '../components/common/Footer.astro';

/* Project-Specific Components */
import FullWidthHero from '../components/projects/FullWidthHero.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';

/* Data: Featured Project Image */
const featuredProject = "https://media.clmconstructionservices.com/projects/p_0_0.webp";

/* Data: Grid Images */
const projects = [
  "https://media.clmconstructionservices.com/projects/p_1_1.webp",
  "https://media.clmconstructionservices.com/projects/p_2_1.webp",
  "https://media.clmconstructionservices.com/projects/p_2_2.webp",
  "https://media.clmconstructionservices.com/projects/p_2_3.webp",
  "https://media.clmconstructionservices.com/projects/p_2_4.webp",
  "https://media.clmconstructionservices.com/projects/p_3_1.webp",
  "https://media.clmconstructionservices.com/projects/p_4_1.webp",
  "https://media.clmconstructionservices.com/projects/p_4_2.webp",
  "https://media.clmconstructionservices.com/projects/p_4_3.webp",
  "https://media.clmconstructionservices.com/projects/p_4_4.webp"

];
---

<Layout title="Projects | CLM Construction Services">
  <main>
    <FullWidthHero img={featuredProject} />
    <ProjectGrid images={projects} />
  </main>
  <Footer />
</Layout>

<style>
  main {
    background-color: white;
  }
</style>