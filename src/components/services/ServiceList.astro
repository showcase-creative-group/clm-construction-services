---
import { Image } from 'astro:assets';

const services = [
  {
    id: "01",
    title: "Civil",
    subtitle: "Civil Construction",
    slug: "civil",
    description: "We clear and build out your project's civil construction in an orderly fashion allowing yourself and clients key access to your location.",
    features: [
      "Roadway and Utility Subgrade Prep",
      "Lime and Cement Stabilization",
      "Asphalt Paving & Repair",
      "Erosion & Environmental Controls"
    ],
    img: "https://media.clmconstructionservices.com/services/s_1.webp"
  },
  {
    id: "02",
    title: "Drainage",
    subtitle: "Drainage Systems",
    slug: "drainage",
    description: "CLM Construction Services create, repairs, and installs the drainage systems needed to make sure your project and site flows properly.",
    features: [
      "HDPE Hydronic Drainage",
      "Open Air Drainage Swales and Channels",
      "Culvert Installation",
      "Drainage Ditch Repairs"
    ],
    img: "https://media.clmconstructionservices.com/services/s_2.webp"
  },
  {
    id: "03",
    title: "Utility",
    subtitle: "Utility Infrastructure",
    slug: "utilities",
    description: "We install the crucial infrastructure needed for systems and facilities that provide essential services such as domestic water, waste management and storm sewer utilities.",
    features: [
      "HDPE Domestic Water Piping Systems",
      "HDPE Sanitary Sewer Systems and Lift Stations",
      "Natural Gas and Oil & Gas Applications",
      "Repair and Replacement of Existing Utility Systems"
    ],
    img: "https://media.clmconstructionservices.com/services/s_3.webp"
  },
  {
    id: "04",
    title: "Earthwork",
    subtitle: "Earthwork Solutions",
    slug: "earthwork",
    description: "Our earthwork services serve a myriad of clients. From large scale institutions and commercial general contractors, to rural farm and ranch entities we seek to provide exceptional earthwork solutions.",
    features: [
      "Earthwork, Grading, and Soil Compaction",
      "Excavation and Trenching",
      "Clearing and Grubbing Site Preparation",
      "Material & Debris Handling and Haul off"
    ],
    img: "https://media.clmconstructionservices.com/services/s_4.webp"
  }
];
---

<section class="services-list">
  {services.map((service, index) => (
    <div id={service.slug} class="service-row">
      <div class="container">
        
        <div class="spine-wrapper">
          <div class="spine-line"></div>
          <div class="spine-dot"></div>
        </div>

        <div class={`content-wrapper ${index % 2 === 1 ? 'reverse' : ''}`}>
          
          <div class="text-col animate-fade-up">
            
            <div class="service-header-block">
              <h2 class="service-title">
                <span class="id-number">{service.id}</span> 
                <span class="separator">—</span> 
                {service.title}
              </h2>
              <span class="subtitle">{service.subtitle}</span>
            </div>

            <p class="description">{service.description}</p>
            
            <ul class="feature-list">
              {service.features.map(item => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="image-col animate-fade-up delay-100">
            <div class="image-frame">
              <Image 
                src={service.img} 
                alt={service.title} 
                width={600} 
                height={450} 
                class="service-list-img"
              />
            </div>
          </div>

        </div>
      </div>
    </div>
  ))}
</section>

<style>
  .services-list {
    background-color: white;
    position: relative;
    overflow: hidden;
  }

  .service-row {
    padding: 6rem 0;
    position: relative;
    scroll-margin-top: 100px;
  }

  .service-row:nth-child(even) {
    background-color: rgba(248, 250, 252, 0.5);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  /* --- Spine --- */
  .spine-wrapper {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    transform: translateX(-50%);
    z-index: 0;
    width: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .spine-line {
    position: absolute;
    top: -6rem; 
    bottom: -6rem; 
    width: 2px;
    background-image: linear-gradient(to bottom, rgba(27, 58, 105, 0.25) 50%, transparent 50%);
    background-size: 1px 12px;
  }

  .spine-dot {
    width: 14px;
    height: 14px;
    background-color: white;
    border: 3px solid var(--color-accent);
    border-radius: 50%;
    z-index: 1;
    position: relative;
  }

  /* --- Layout --- */
  .content-wrapper {
    display: flex;
    align-items: center;
    gap: 6rem; 
    position: relative;
    z-index: 1;
  }

  .content-wrapper.reverse {
    flex-direction: row-reverse;
  }

  .text-col {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* --- DESKTOP ALIGNMENT LOGIC (The "Hug" Effect) --- */
  @media (min-width: 993px) {
    .content-wrapper:not(.reverse) .text-col {
      align-items: flex-end;
      text-align: right;     
    }

    .content-wrapper:not(.reverse) .service-title {
      justify-content: flex-end;
    }

    .content-wrapper:not(.reverse) .feature-list li {
      flex-direction: row-reverse;
    }
  }

  /* --- Typography --- */
  .service-header-block {
    margin-bottom: 1.5rem;
  }

  .service-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: var(--color-primary); 
    text-transform: uppercase;
    line-height: 1;
    margin: 0 0 0.5rem 0; 
    display: flex;
    align-items: center;
    flex-wrap: wrap; 
    gap: 0.5rem;
  }

  .id-number {
    color: var(--color-accent); 
  }

  .separator {
    color: rgba(27, 58, 105, 0.3);
    margin: 0 0.25rem;
  }

  .subtitle {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent); 
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-main); 
    margin: 0 0 1.5rem 0;
    max-width: 500px;
  }

  /* --- Feature List --- */
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary); 
  }

  .check-icon {
    width: 20px;
    height: 20px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* --- Image --- */
  .image-col {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .image-frame {
    position: relative;
    width: 100%;
    /* UPDATED: Reduced from 600px to 520px */
    max-width: 520px;
    aspect-ratio: 4/3;
  }

  /* UPDATED: Selector targeting the class on the Astro Image component */
  .service-list-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    position: relative;
    z-index: 2;
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.2);
  }

  /* --- Animation --- */
  .animate-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .animate-fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .delay-100 {
    transition-delay: 0.1s;
  }

  /* --- Responsive: Unified 992px Breakpoint --- */
  @media (max-width: 992px) {
    .spine-wrapper {
      left: 1.5rem;
      transform: none;
      align-items: flex-start; 
    }
    
    .spine-dot {
      margin-left: -9px;
      top: 1.5rem; 
    }

    .spine-line {
      left: 0;
    }

    .content-wrapper, 
    .content-wrapper.reverse {
      flex-direction: column;
      gap: 3rem;
      text-align: left;
      align-items: stretch;
      padding-left: 3rem; 
    }

    .content-wrapper:not(.reverse) .feature-list li {
      flex-direction: row !important;
    }

    .content-wrapper:not(.reverse) .service-title {
      justify-content: flex-start !important;
    }

    .image-frame { 
      max-width: 100%;
    }
  }
</style>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);
  document.querySelectorAll('.animate-fade-up').forEach((el) => {
    observer.observe(el);
  });
</script>