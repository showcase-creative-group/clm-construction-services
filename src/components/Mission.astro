---
const services = [
  {
    id: "01",
    title: "Civil",
    desc: "Public streets, layout, storm sewer, site stabilization, and embankments.",
    img: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop"
  },
  {
    id: "02",
    title: "Drainage",
    desc: "Box culverts, detention ponds, concrete channels, and underground detention.",
    img: "https://images.unsplash.com/photo-1621905252507-b35492cc74b4?q=80&w=2069&auto=format&fit=crop"
  },
  {
    id: "03",
    title: "Utilities",
    desc: "Water, sanitary sewer, fire lines, domestic water, and storm sewer systems.",
    img: "https://images.unsplash.com/photo-1605600659908-0ef719419d41?q=80&w=2073&auto=format&fit=crop"
  },
  {
    id: "04",
    title: "Earthwork",
    desc: "Mass excavation, rough grade, building pads, final grade, and detention ponds.",
    img: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=2076&auto=format&fit=crop"
  }
];
---

<section class="mission-section">
  
  <div class="foundation-block">
    <div class="container split-layout">
      <div class="text-content">
        <h2>
          At CLM, We Build On A<br/>
          <span class="highlight">Solid Foundation</span>
        </h2>
      </div>
      <div class="expertise-box">
        <p class="intro-text">
            Started in Brazos Valley over 35 years ago, CLM Construction Services has placed millions of feet of pipe and performed countless utility projects.
        </p>
        <p class="mission-statement">We build on a solid foundation so your project can succeed.</p>
      </div>
    </div>
  </div>

  <div class="services-block-grid">
    {services.map((service) => (
      <div class="service-block" style={`--hover-bg: url('${service.img}')`}>
        <div class="hover-bg-layer"></div>
        <div class="hover-overlay-layer"></div>

        <div class="block-content">
          <span class="service-number">{service.id}</span>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-desc">{service.desc}</p>
        </div>
      </div>
    ))}
  </div>

</section>

<style>
  /* --- 1. Foundation Top Section --- */
  .foundation-block {
    background-color: #f6f6f6;
    color: #1e293b;
    padding: 6rem 0;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem; 
  }

  .split-layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
  }

  h2 {
    font-size: 4rem;
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
    margin: 0;
    color: #1e293b;
  }

  .highlight {
    color: #38bdf8;
  }

  .expertise-box {
    max-width: 600px;
    border-left: 4px solid #38bdf8;
    padding-left: 2.5rem; 
  }

  .intro-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 1.5rem; 
  }

  .mission-statement {
    font-weight: 700;
    font-size: 1.25rem;
    color: #1e293b;
    text-transform: uppercase;
  }

  /* --- 2. The Service Grid --- */
  .services-block-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
  }

  .service-block {
    position: relative;
    background-color: #1e293b;
    color: white;
    padding: 3.5rem 2rem; 
    border-right: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 500px;
    overflow: hidden;
    cursor: default;
  }

  /* --- Background Hover Logic --- */
  .hover-bg-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: var(--hover-bg);
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.4s ease-in-out, transform 6s linear;
    z-index: 0;
    pointer-events: none;
  }

  .hover-overlay-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(15, 23, 42, 0.75);
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
    z-index: 1;
    pointer-events: none;
  }

  .service-block:hover .hover-bg-layer {
    opacity: 1;
    transform: scale(1.1);
  }

  .service-block:hover .hover-overlay-layer {
    opacity: 1;
  }

  /* --- Content Styling --- */
  .block-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .service-number {
    font-size: 1rem;
    color: rgba(255,255,255,0.6);
    margin-bottom: 1.5rem; 
    font-weight: 500;
  }

  .service-title {
    font-size: 3.5rem;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.9;
    margin: 0 0 1.5rem 0;
    font-family: 'Barlow', sans-serif;
  }

  .service-desc {
    font-size: 1.35rem; 
    line-height: 1.4; 
    font-weight: 500;
    color: #e2e8f0;
    margin-bottom: auto;
  }

  /* --- Responsive Design --- */
  @media (max-width: 1200px) {
    .services-block-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .service-title { font-size: 3rem; }
    h2 { font-size: 3rem; }
  }

  @media (max-width: 768px) {
    .foundation-block {
      padding: 4rem 0;
    }
    
    .split-layout {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
    
    .expertise-box {
        border-left: none;
        border-top: 4px solid #38bdf8;
        padding-left: 0;
        padding-top: 1.5rem;
    }

    .services-block-grid {
      grid-template-columns: 1fr;
    }

    .service-block {
        min-height: auto; 
        padding: 3rem 1.5rem; 
    }

    .service-title { font-size: 2.5rem; }
  }
</style>