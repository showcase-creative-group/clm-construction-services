---
/* src/pages/thumbnail-preview.astro */
import logo from '../assets/logo.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@600;800&display=swap" rel="stylesheet">
  
  <style>
    body {
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background-color: #333;
      font-family: 'Barlow', sans-serif;
    }

    .og-card {
      /* Standard Open Graph Dimensions */
      width: 1200px;
      height: 630px;
      background-color: #ffffff;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      box-shadow: 0 0 50px rgba(0,0,0,0.5); /* Shadow just for preview visibility */
    }

    /* --- DECORATIVE RIGHT SIDE (The "Structure") --- */
    .geometric-shape {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 45%;
      background-color: #1B3A69; /* var(--clm-navy) */
      clip-path: polygon(25% 0, 100% 0, 100% 100%, 0% 100%);
      z-index: 1;
    }

    /* Accent Line */
    .geometric-shape::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: 15px;
      background-color: #31888D; /* var(--clm-aqua) */
      transform: translateX(-15px); /* Puts it right on the edge */
    }

    /* --- CONTENT AREA --- */
    .content-left {
      width: 60%;
      padding: 5rem;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
      box-sizing: border-box;
    }

    .logo-container {
      margin-bottom: 2rem;
    }

    .logo-img {
      height: 110px; /* Larger logo since we have white space */
      width: auto;
      /* NO FILTER needed - Logo shows in original colors */
    }

    h1 {
      font-size: 4.8rem;
      font-weight: 800;
      line-height: 1;
      text-transform: uppercase;
      color: #1B3A69; /* Navy Text */
      margin: 0;
    }

    .highlight {
      color: #31888D; /* Aqua Text */
    }

    .tagline-group {
      margin-top: auto;
    }

    .divider {
      width: 80px;
      height: 8px;
      background-color: #31888D;
      margin-bottom: 1.5rem;
    }

    p {
      font-size: 1.6rem;
      font-weight: 600;
      color: #64748b; /* Slate Gray */
      margin: 0;
      max-width: 90%;
      line-height: 1.4;
    }

  </style>
</head>
<body>
  
  <div class="og-card">
    
    <div class="geometric-shape">
        </div>

    <div class="content-left">
      <div class="logo-container">
        <img src={logo.src} alt="CLM Construction Services" class="logo-img" />
      </div>

      <h1>
        Building on a<br>
        <span class="highlight">Solid Foundation</span>
      </h1>

      <div class="tagline-group">
        <div class="divider"></div>
        <p>Premier Earthwork & Utility Contractor Serving the Brazos Valley.</p>
      </div>
    </div>

  </div>

</body>
</html>