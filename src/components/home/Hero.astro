---
---

<section class="hero">
  <video class="hero-video" autoplay muted loop playsinline>
    <source src="https://media.clmconstructionservices.com/home/h_0_broll.mp4" type="video/mp4">
    Your browser does not support the video tag.
  </video>

  <div class="overlay"></div>
  
  <div class="content">
    <h1>
      <span class="text-line" style="--delay: 0.1s">PREMIER</span>
      <span class="text-line" style="--delay: 0.2s">BRAZOS</span>
      <span class="text-line" style="--delay: 0.3s">VALLEY</span>
      <span class="text-line" style="--delay: 0.4s">EARTHWORK</span>
      <span class="text-line" style="--delay: 0.5s">AND UTILITY</span>
      <span class="text-line" style="--delay: 0.6s">CONTRACTOR</span>
    </h1>
    <p class="tagline" style="--delay: 0.8s">Industry leading experience with HDPE pipe</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* 90% viewport height */
    min-height: 90vh; 
    display: flex;
    align-items: center;
    justify-content: center; 
    color: white;
    overflow: hidden;
    background-color: #1e293b;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4); 
    z-index: 1; 
  }

  .content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    /* FLEXBOX SETTINGS FOR RIGHT ALIGNMENT */
    display: flex;
    flex-direction: column;
    align-items: flex-end; 
    text-align: right;
  }

  h1 {
    /* Adjusted from 6rem down to 5rem */
    font-size: 5rem;
    font-weight: 800; 
    
    /* Kept tight line-height for the "stacked block" look */
    line-height: 0.9; 
    
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    margin-top: 0;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.6);
  }

  /* --- ANIMATION LOGIC --- */

  /* Defines the "starting state" for lines: invisible and shifted down */
  .text-line, .tagline {
    display: block; /* Ensures they stack like lines */
    opacity: 0;
    transform: translateY(40px);
    animation: fadeInUp 0.8s ease-out forwards;
    animation-delay: var(--delay); /* Uses the delay set in the HTML */
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tagline {
    font-size: 1.25rem;
    background-color: white;
    color: #1e293b; 
    display: inline-block;
    padding: 0.5rem 1rem;
    font-weight: 600;
    border-radius: 2px;
  }

  /* Tablet Adjustments */
  @media (max-width: 1024px) {
    h1 {
      /* Adjusted proportionally */
      font-size: 3.5rem;
    }
  }

  /* Mobile Adjustments */
  @media (max-width: 768px) {
    .hero {
      min-height: 70vh;
    }

    h1 {
      /* Safe size for mobile phones */
      font-size: 2.25rem;
      line-height: 1.0; 
    }
  }
</style>