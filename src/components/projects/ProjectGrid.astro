---
interface Props {
  images: string[];
}

const { images } = Astro.props;
---

<section class="gallery-section">
  <div class="container">
    <div class="grid">
      {images.map((img, index) => (
        <div class="grid-item">
          <img src={img} alt={`Project ${index + 1}`} loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-section {
    padding: 4rem 0 6rem 0;
    background-color: white;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .grid-item {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    background-color: #e2e8f0; /* Placeholder gray is fine, or use var(--color-primary) with low opacity */
    box-shadow: 0 4px 12px rgba(27, 58, 105, 0.1); /* Navy shadow */
    cursor: pointer;
  }

  .grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .grid-item:hover img {
    transform: scale(1.03);
  }

  /* Unified 992px Breakpoint */
  @media (max-width: 992px) {
    .grid {
      /* Switching directly to 1 column for strict consistency, 
         or we can do 2 columns here if you prefer. 
         Let's stick to the requested rule: */
      grid-template-columns: 1fr; 
      gap: 1.5rem;
    }
    
    .gallery-section {
      padding: 3rem 0;
    }
  }
</style>