---
import Header from '../components/common/Header.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Premier Brazos Valley earthwork and utility contractor." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&display=swap" rel="stylesheet">

		<title>{title}</title>
	</head>
	<body>
		<Header />
		
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--clm-navy: #1B3A69;
		--clm-teal: #31888D;
		--clm-aqua: #46C4C1;
		--clm-gray: #636466;
		
		--color-primary: var(--clm-navy);
		--color-accent: var(--clm-aqua);
		--color-secondary: var(--clm-teal);
		--color-text-main: var(--clm-gray);
	}
	
	html {
		font-family: 'Barlow', sans-serif; 
		background: #f6f6f6;
		margin: 0;
		padding: 0;
		color: var(--color-text-main);
	}
	
	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
	}

	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
</style>