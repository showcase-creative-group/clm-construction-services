{
  "name": "clm-construction-services",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2025-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "clm-construction-services"
    }
  ]
}