---
import { Image } from 'astro:assets';

interface Props {
  images: string[];
}

const { images } = Astro.props;
---

<section class="gallery-section">
  <div class="container">
    <div class="grid">
      {images.map((img, index) => (
        <div class="grid-item">
          <Image 
            src={img} 
            alt={`Project ${index + 1}`}
            width={800}
            height={600}
            class="project-img"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-section {
    padding: 4rem 0 6rem 0;
    background-color: white;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .grid-item {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    background-color: #e2e8f0;
    box-shadow: 0 4px 12px rgba(27, 58, 105, 0.1);
    cursor: pointer;
  }

  /* Updated selector for the Astro Image component */
  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .grid-item:hover .project-img {
    transform: scale(1.03);
  }

  /* Unified 992px Breakpoint */
  @media (max-width: 992px) {
    .grid {
      grid-template-columns: 1fr; 
      gap: 1.5rem;
    }
    
    .gallery-section {
      padding: 3rem 0;
    }
  }
</style>