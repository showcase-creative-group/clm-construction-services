---
import ServiceCard from './ServiceCard.astro';

const services = [
  {
    id: "01",
    title: "Civil",
    subtitle: "Civil Construction",
    slug: "civil",
    description: "We self-perform all facets of your civil construction project.",
    features: [
      "Excavation",
      "Subgrade Preparation",
      "Lime and Cement Stabilization",
      "Material Handling"
    ],
    img: "https://media.clmconstructionservices.com/services/s_1.webp"
  },
  {
    id: "02",
    title: "HDPE",
    subtitle: "HDPE Systems",
    slug: "hdpe",
    description: "CLM Construction Services specializes in all aspects of HDPE installations across all material sectors.",
    features: [
      "Drainage Systems",
      "Domestic Water",
      "Sanitary Sewer",
      "Thermal Heating & Cooling"
    ],
    img: "https://media.clmconstructionservices.com/services/s_2.webp"
  },
  {
    id: "03",
    title: "Utility",
    subtitle: "Utility Infrastructure",
    slug: "utility",
    description: "We install all features of utility infrastructure for services such as domestic water, sanitary sewer, and drainage.",
    features: [
      "Domestic Water Piping Systems",
      "Sanitary Sewer Systems and Lift Stations",
      "Storm Drain and Detention Facilities",
      "Repair and Replacement of Existing Utility Systems"
    ],
    img: "https://media.clmconstructionservices.com/services/s_3.webp"
  },
  {
    id: "04",
    title: "Earthwork",
    subtitle: "Earthwork Solutions",
    slug: "earthwork",
    description: "Our earthwork services serve a myriad of clients. From large scale institutions and commercial general contractors, to rural farm and ranch owners we seek to provide exceptional earthwork solutions.",
    features: [
      "Clearing and Grubbing",
      "Earthwork, Grading, and Compaction",
      "Site Preparation",
      "Paving, Subgrade, and Stabilization"
    ],
    img: "https://media.clmconstructionservices.com/services/s_4.webp"
  }
];
---

<section class="services-wrapper">
  <div class="services-list">
    {services.map((service, index) => (
      <ServiceCard 
        {...service} 
        index={index} 
        totalServices={services.length}
      />
    ))}
  </div>
</section>

<style>
  .services-wrapper {
    width: 100%;
    background-color: white;
  }
  
  .services-list {
    width: 100%;
    overflow: hidden;
  }
</style>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.animate-fade-up').forEach((el) => {
    observer.observe(el);
  });
</script>