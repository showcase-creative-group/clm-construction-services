---

<Layout title="Projects | CLM Construction Services">
  <main>
    <FullWidthHero img={featuredProject} />
    <ProjectIntro /> 
    <ProjectGrid images={projects} />
  </main>
  <Footer />
</Layout>

<style>
  main {
    background-color: white;
    min-height: 100vh;
  }
</style>