---
import { Image } from 'astro:assets';

const projects = [
  {
    img: "https://media.clmconstructionservices.com/home/h_1.webp"
  },
  {
    img: "https://media.clmconstructionservices.com/home/h_2.webp"
  },
  {
    img: "https://media.clmconstructionservices.com/home/h_3.webp"
  },
  {
    img: "https://media.clmconstructionservices.com/home/h_4.webp"
  },
  {
    img: "https://media.clmconstructionservices.com/home/h_5.webp"
  },
  {
    img: "https://media.clmconstructionservices.com/home/h_6.webp"
  }
];
---

<section class="recent-work">
  <div class="container">
    
    <div class="section-header">
      <div class="header-text">
        <h2>Recent Work</h2>
        <div class="bar"></div>
      </div>
      
      <div class="controls">
        <button id="prevBtn" class="nav-btn" aria-label="Previous Project" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
        </button>
        <button id="nextBtn" class="nav-btn" aria-label="Next Project" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </button>
      </div>
    </div>

    <div class="slider-container" id="slider-container">
      <div class="slider-track" id="track">
        {projects.map((project, index) => (
          <div class="slide">
            <div class="image-card">
              <Image 
                src={project.img} 
                alt={`Recent Project ${index + 1}`}
                width={800}
                height={600}
                class="slide-img"
              />
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .recent-work {
    background-color: white;
    padding: 6rem 0;
    overflow: hidden;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header Layout */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  h2 {
    font-size: 3.5rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-primary); /* Brand Navy */
    line-height: 1;
    margin: 0;
  }

  .bar {
    width: 60px;
    height: 6px;
    background-color: var(--color-accent); /* Brand Aqua */
    margin-top: 1rem;
  }

  /* Navigation Buttons */
  .controls {
    display: flex;
    gap: 1rem;
  }

  .nav-btn {
    background: var(--color-primary); /* Brand Navy */
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .nav-btn:hover {
    background-color: var(--color-accent); /* Brand Aqua */
    transform: scale(1.05);
  }

  .nav-btn svg {
    width: 24px;
    height: 24px;
    pointer-events: none;
  }

  /* Slider Logic */
  .slider-container {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE 10+ */
    scroll-behavior: smooth;
  }
  .slider-container::-webkit-scrollbar { 
    display: none; /* Chrome/Safari */
  }

  .slider-track {
    display: flex;
    gap: 2rem;
  }

  .slide {
    flex: 0 0 100%;
    max-width: 100%;
  }

  /* Image Card Styling */
  .image-card {
    width: 100%;
    height: 500px; 
    overflow: hidden;
    background-color: #cbd5e1;
    border-radius: 4px;
  }

  /* UPDATED: Selector targeting the class on the Astro Image component */
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .image-card:hover .slide-img {
    transform: scale(1.03);
  }

  /* --- Breakpoints: Unified 992px Rule --- */
  
  /* Desktop: 3 slides */
  @media (min-width: 993px) {
    .slide {
      flex: 0 0 calc(33.333% - 1.33rem);
      max-width: calc(33.333% - 1.33rem);
    }
  }

  /* Tablet/Mobile: 1 slide (or partial) */
  @media (max-width: 992px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
    
    h2 {
      font-size: 2.5rem;
    }

    .slide {
      /* Show 1 slide + a peek of the next one for UX cue */
      flex: 0 0 85%;
      max-width: 85%;
    }

    .image-card {
      height: 350px;
    }
  }
</style>

<script>
  // UPDATED: Now selecting the container that actually has the scroll bar
  const container = document.getElementById('slider-container');
  const track = document.getElementById('track');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  if (container && track && prevBtn && nextBtn) {
    
    const getScrollAmount = () => {
      const slide = track.querySelector('.slide');
      if (!slide) return 0;
      
      // Get the gap from the track flex container
      const style = window.getComputedStyle(track);
      const gap = parseFloat(style.gap || style.columnGap) || 32; 
      
      return slide.clientWidth + gap;
    };

    nextBtn.addEventListener('click', () => {
      const amount = getScrollAmount();
      // Scroll the container, not the track
      const maxScroll = container.scrollWidth - container.clientWidth;
      
      if (container.scrollLeft >= maxScroll - 10) {
        container.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        container.scrollBy({ left: amount, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', () => {
      const amount = getScrollAmount();
      
      if (container.scrollLeft <= 10) {
        container.scrollTo({ left: container.scrollWidth, behavior: 'smooth' });
      } else {
        container.scrollBy({ left: -amount, behavior: 'smooth' });
      }
    });
  }
</script>