<section class="stats-bar">
  <div class="container">

    <div class="stat-item">
      <span class="number">35</span>
      <span class="label">Years Experience</span>
    </div>

    <div class="divider"></div>
    
    <div class="stat-item">
      <span class="number">1.9 MILLION</span>
      <span class="label">Feet of Pipe Placed</span>
    </div>

    <div class="divider"></div>

    <div class="stat-item">
      <span class="number">150+</span>
      <span class="label">Projects Completed</span>
    </div>

  </div>
</section>

<style>
  .stats-bar {
    /* UPDATED: Light background to contrast with the dark Mission grid above and Footer below */
    background-color: #f6f6f6; 
    color: #1e293b;
    padding: 6rem 0;
    border-bottom: 1px solid rgba(30, 41, 59, 0.05); /* Subtle bottom border */
  }

  .container {
    max-width: 1400px; /* Match the wider container of Mission/Hero */
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between; /* Spread items evenly */
    align-items: center;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1; /* Each item takes equal width */
  }

  .number {
    /* UPDATED: Huge "Hero" sizing for the numbers */
    font-size: 5rem; 
    font-weight: 800;
    line-height: 1;
    color: #38bdf8; /* Brand Blue for pop */
    font-family: 'Barlow', sans-serif;
    margin-bottom: 0.5rem;
  }

  .label {
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #1e293b; /* Dark Navy */
    font-family: 'Barlow', sans-serif;
  }

  /* --- Dividers --- */
  .divider {
    width: 1px;
    height: 80px; /* Tall vertical line */
    background-color: rgba(30, 41, 59, 0.1); /* Subtle dark line */
    margin: 0 2rem;
  }

  /* --- Responsive Design --- */
  @media (max-width: 900px) {
    .number {
      font-size: 4rem;
    }
    
    .label {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 768px) {
    .stats-bar {
      padding: 4rem 0;
    }

    .container {
      flex-direction: column;
      gap: 3rem;
    }

    .divider {
      width: 60px; /* Horizontal line on mobile */
      height: 2px;
      margin: 0;
    }
    
    .number {
      font-size: 3.5rem;
    }
  }
</style>