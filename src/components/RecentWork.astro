---
/* UPDATED: 6 Images, no text overlays. */
const projects = [
  {
    img: "https://images.unsplash.com/photo-1621905251189-fc0153077430?q=80&w=2069&auto=format&fit=crop"
  },
  {
    img: "https://images.unsplash.com/photo-1581094794329-c8112a89af12?q=80&w=2070&auto=format&fit=crop"
  },
  {
    img: "https://images.unsplash.com/photo-1605600659873-d808a13e4d2a?q=80&w=2073&auto=format&fit=crop"
  },
  {
    img: "https://images.unsplash.com/photo-1590486803833-1c5dc8ce84ac?q=80&w=2070&auto=format&fit=crop"
  },
  {
    img: "https://images.unsplash.com/photo-1535732759880-bbd5c7265e3f?q=80&w=2000&auto=format&fit=crop"
  },
  {
    img: "https://images.unsplash.com/photo-1589939705384-5185137a7f0f?q=80&w=2070&auto=format&fit=crop"
  }
];
---

<section class="recent-work">
  <div class="container">
    
    <div class="section-header">
      <div class="header-text">
        <h2>Recent Work</h2>
        <div class="bar"></div>
      </div>
      
      <div class="controls">
        <button id="prevBtn" class="nav-btn" aria-label="Previous Project">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
        </button>
        <button id="nextBtn" class="nav-btn" aria-label="Next Project">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </button>
      </div>
    </div>

    <div class="slider-container">
      <div class="slider-track" id="track">
        {projects.map((project) => (
          <div class="slide">
            <div class="image-card">
              <img src={project.img} alt="Recent Project" loading="lazy" />
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .recent-work {
    background-color: white;
    padding: 6rem 0;
    overflow: hidden;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header Layout */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  h2 {
    font-size: 3.5rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #1e293b;
    line-height: 1;
    margin: 0;
  }

  .bar {
    width: 60px;
    height: 6px;
    background-color: #38bdf8;
    margin-top: 1rem;
  }

  /* Navigation Buttons */
  .controls {
    display: flex;
    gap: 1rem;
  }

  .nav-btn {
    background: #1e293b;
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .nav-btn:hover {
    background-color: #38bdf8;
    transform: scale(1.05);
  }

  .nav-btn svg {
    width: 24px;
    height: 24px;
  }

  /* Slider Logic */
  .slider-container {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE 10+ */
    scroll-behavior: smooth;
  }
  .slider-container::-webkit-scrollbar { 
    display: none; /* Chrome/Safari */
  }

  .slider-track {
    display: flex;
    gap: 2rem; /* 2rem = 32px approx */
  }

  .slide {
    flex: 0 0 100%;
    max-width: 100%;
  }

  /* Image Card Styling */
  .image-card {
    width: 100%;
    height: 500px; 
    overflow: hidden;
    background-color: #cbd5e1;
    border-radius: 4px;
  }

  .image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .image-card:hover img {
    transform: scale(1.03);
  }

  /* --- Breakpoints --- */
  
  /* Tablet: 2 slides */
  @media (min-width: 768px) {
    .slide {
      flex: 0 0 calc(50% - 1rem);
      max-width: calc(50% - 1rem);
    }
  }

  /* Desktop: 3 slides */
  @media (min-width: 1200px) {
    .slide {
      flex: 0 0 calc(33.333% - 1.33rem); 
      max-width: calc(33.333% - 1.33rem);
    }
  }

  /* Mobile Adjustments */
  @media (max-width: 768px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
    
    h2 {
      font-size: 2.5rem;
    }

    .image-card {
      height: 350px; 
    }
  }
</style>

<script>
  /* UPDATED: JavaScript to handle infinite Cycling */
  const track = document.getElementById('track');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  if (track && prevBtn && nextBtn) {
    
    const getSlideWidth = () => {
      const slide = track.querySelector('.slide');
      // Width of slide + the gap (2rem = 32px)
      return slide ? slide.clientWidth + 32 : 0;
    };

    nextBtn.addEventListener('click', () => {
      const slideWidth = getSlideWidth();
      const maxScroll = track.scrollWidth - track.clientWidth;
      
      // If we are within 10px of the end, loop back to start
      if (track.scrollLeft >= maxScroll - 10) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        // Otherwise scroll normally
        track.scrollBy({ left: slideWidth, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', () => {
      const slideWidth = getSlideWidth();
      
      // If we are at the start, loop to the end
      if (track.scrollLeft <= 10) {
        track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
      } else {
        // Otherwise scroll back
        track.scrollBy({ left: -slideWidth, behavior: 'smooth' });
      }
    });
  }
</script>