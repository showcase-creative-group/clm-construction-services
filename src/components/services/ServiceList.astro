---
/* src/components/services/ServiceList.astro */
import ServiceCard from './ServiceCard.astro';

const services = [
  {
    id: "01",
    title: "Civil",
    subtitle: "Civil Construction",
    slug: "civil",
    description: "We self-perform all facets of your civil construction project.",
    features: [
      "Excavation",
      "Subgrade Preparation",
      "Lime and Cement Stabilization",
      "Material Handling"
    ],
    img: "https://media.clmconstructionservices.com/services/s_1.webp"
  },
  {
    id: "02",
    title: "HDPE",
    subtitle: "HDPE Systems",
    slug: "hdpe",
    description: "CLM Construction Services specializes in all aspects of HDPE installations across all material sectors.",
    features: [
      "Drainage Systems",
      "Domestic Water",
      "Sanitary Sewer",
      "Thermal Heating & Cooling"
    ],
    img: "https://media.clmconstructionservices.com/services/s_2.webp"
  },
  {
    id: "03",
    title: "Utility",
    subtitle: "Utility Infrastructure",
    slug: "utility",
    description: "We install all features of utility infrastructure for services such as domestic water, sanitary sewer, and drainage.",
    features: [
      "Domestic Water Piping Systems",
      "Sanitary Sewer Systems and Lift Stations",
      "Storm Drain and Detention Facilities",
      "Repair and Replacement of Existing Utility Systems"
    ],
    img: "https://media.clmconstructionservices.com/services/s_3.webp"
  },
  {
    id: "04",
    title: "Earthwork",
    subtitle: "Earthwork Solutions",
    slug: "earthwork",
    description: "Our earthwork services serve a myriad of clients. From large scale institutions and commercial general contractors, to rural farm and ranch owners we seek to provide exceptional earthwork solutions.",
    features: [
      "Clearing and Grubbing",
      "Earthwork, Grading, and Compaction",
      "Site Preparation",
      "Paving, Subgrade, and Stabilization"
    ],
    img: "https://media.clmconstructionservices.com/services/s_4.webp"
  }
];
---

<div class="nav-wrapper">
  <div class="container">
    <nav class="nav-grid">
      {services.map((service) => (
        <a href={`#${service.slug}`} class="nav-card">
          <span class="nav-number">{service.id}</span>
          <span class="nav-title">{service.title}</span>
        </a>
      ))}
    </nav>
  </div>
</div>

<section class="services-wrapper">
  <div class="services-list">
    {services.map((service, index) => (
      <ServiceCard 
        {...service} 
        index={index} 
        totalServices={services.length}
      />
    ))}
  </div>
</section>

<style>
  /* --- Navigation Wrapper --- */
  .nav-wrapper {
    background-color: white;
    /* Minimal padding for a button bar feel */
    padding: 1.5rem 0; 
    border-bottom: 1px solid rgba(27, 58, 105, 0.05);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* --- Navigation Grid --- */
  .nav-grid {
    display: grid;
    /* Desktop: 4 Columns */
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  /* --- Nav Button Design --- */
  .nav-card {
    display: flex;
    flex-direction: row; 
    align-items: center; 
    justify-content: center; /* Center content perfectly */
    gap: 0.75rem;
    
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    
    /* Button-like Padding */
    padding: 0.5rem 1rem; 
    
    text-decoration: none;
    border-radius: 4px; /* Matches Footer Chip Shape */
    transition: all 0.2s ease;
    
    /* Standard Button Height */
    min-height: 48px; 
    position: relative;
    overflow: hidden;
  }

  .nav-card:hover {
    background-color: var(--color-primary); /* Navy */
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(27, 58, 105, 0.15);
    border-color: var(--color-primary);
  }

  /* --- Internal Elements --- */
  .nav-number {
    font-size: 0.85rem;
    font-weight: 700;
    color: #94a3b8;
    transition: color 0.3s ease;
    line-height: 1;
  }

  .nav-title {
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-primary);
    font-family: 'Barlow', sans-serif;
    transition: color 0.3s ease;
    z-index: 1;
    line-height: 1;
  }

  /* --- Hover States --- */
  .nav-card:hover .nav-number {
    color: rgba(255, 255, 255, 0.4);
  }

  .nav-card:hover .nav-title {
    color: white;
  }

  /* --- Existing Styles --- */
  .services-wrapper {
    width: 100%;
    background-color: white;
  }
  
  .services-list {
    width: 100%;
    overflow: hidden;
  }

  /* --- Responsive --- */
  @media (max-width: 992px) {
    .nav-wrapper {
      padding: 1.25rem 0;
    }

    .nav-grid {
      /* Mobile: 2x2 Grid */
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .nav-card {
      padding: 0.5rem 0.75rem;
      min-height: 44px;
      gap: 0.5rem;
    }

    .nav-title {
      font-size: 0.95rem;
    }
    
    .nav-number {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.animate-fade-up').forEach((el) => {
    observer.observe(el);
  });
</script>