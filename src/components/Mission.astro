<style>
  /* --- Top Foundation Section --- */
  .foundation-block {
    /* Updated to Brand Dark Navy */
    background-color: #1e293b; 
    color: white;
    padding: 6rem 0; /* More vertical breathing room */
    position: relative;
    overflow: hidden;
  }

  /* Optional: Adds a subtle line texture to the background for industrial feel */
  .foundation-block::before {
    content: "";
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.03) 0px, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 10px);
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 2;
  }

  .split-layout {
    display: flex;
    align-items: flex-start; /* Aligns top of text with top of box */
    justify-content: space-between;
    gap: 4rem;
  }

  h2 {
    font-size: 4rem; /* Larger for Barlow */
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
  }

  /* The accent color text */
  .highlight {
    color: #38bdf8;
    display: block; /* Forces it to its own line */
    margin-top: 0.5rem;
  }

  /* --- Expertise Box Styling --- */
  .expertise-box {
    background-color: #0f172a; /* Darker slate for contrast against the background */
    max-width: 550px;
    border-radius: 4px;
    overflow: hidden; /* Keeps border radius clean */
    box-shadow: 0 10px 30px rgba(0,0,0,0.3); /* Deep shadow to make it "float" */
    border-left: 6px solid #38bdf8; /* Blue accent bar on the left */
  }

  .box-header {
    background-color: rgba(255,255,255,0.05);
    padding: 1.5rem 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .expertise-box h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: white;
  }

  .box-content {
    padding: 2rem;
  }

  .expertise-box p {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: #cbd5e1; /* Light gray text */
  }

  .mission-statement {
    font-weight: 700;
    color: white !important;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 1.5rem;
    margin-bottom: 0 !important;
  }

  /* --- Bottom Services Section --- */
  .services-grid-container {
    background-color: white;
    padding: 6rem 0;
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    text-align: center;
  }

  /* Icon Circle Container */
  .icon-circle {
    width: 80px;
    height: 80px;
    background-color: #f1f5f9; /* Very light gray background */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem auto;
    transition: all 0.3s ease;
  }
  
  .icon-circle svg {
    width: 40px;
    height: 40px;
    stroke: #1e293b; /* Dark Navy Icon */
    stroke-width: 1.5;
    transition: stroke 0.3s ease;
  }

  /* Hover Effects for Service Items */
  .service-item:hover .icon-circle {
    background-color: #38bdf8; /* Turns blue on hover */
    transform: translateY(-5px); /* Floats up slightly */
  }

  .service-item:hover .icon-circle svg {
    stroke: white; /* Icon turns white */
  }

  .service-item h4 {
    color: #1e293b;
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.75rem;
  }

  .service-item p {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.5;
    max-width: 250px;
    margin: 0 auto;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    h2 {
      font-size: 3rem;
    }
  }

  @media (max-width: 900px) {
    .split-layout {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    .expertise-box {
        max-width: 100%;
    }

    .grid-layout {
      grid-template-columns: 1fr 1fr; /* 2 columns on tablet */
      gap: 3rem;
    }
  }

  @media (max-width: 600px) {
    .grid-layout {
      grid-template-columns: 1fr; /* 1 column on mobile */
    }
    
    h2 {
      font-size: 2.5rem;
    }
    
    .foundation-block {
        padding: 4rem 0;
    }
  }
</style>