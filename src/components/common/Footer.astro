---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    
    <div class="footer-col brand-col">
      <h3>CLM Construction Services</h3>
      <p class="description">Premier Brazos Valley earthwork and utility contractor with over 35 years of experience delivering exceptional results.</p>
      
      <div class="contact-info">
        <div class="contact-item">
          <span class="label">HQ</span>
          <span class="value">College Station, TX</span>
        </div>
        <div class="contact-item">
          <span class="label">PHONE</span>
          <a href="tel:9795550123" class="phone-link">(979) 555-0123</a>
        </div>
      </div>
    </div>

    <div class="footer-col">
      <h4>PAGES</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/services">Services</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>SERVICES</h4>
      <ul>
        <li><a href="/services#civil">Civil</a></li>
        <li><a href="/services#drainage">Drainage</a></li>
        <li><a href="/services#utilities">Utilities</a></li>
        <li><a href="/services#earthwork">Earthwork</a></li>
      </ul>
    </div>

  </div>
  
  <div class="bottom-bar">
    <div class="bottom-container">
      <p>&copy; {currentYear} CLM Construction Services. All rights reserved.</p>
      <p class="credit">
        Proudly built by 
        <a href="https://showcasecreativegroup.com" target="_blank" rel="noopener noreferrer">
          Showcase Creative Group
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: #1e293b; /* Dark Navy */
    color: white;
    padding-top: 5rem;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem 1.5rem;
    display: grid;
    /* 2fr for brand allows the description and contact info to breathe */
    grid-template-columns: 2fr 1fr 1fr;
    gap: 4rem; /* Increased gap slightly */
  }

  /* Brand Typography */
  h3 {
    margin-top: 0;
    font-size: 1.5rem;
    font-weight: 800; /* Extra Bold for Brand Name */
    margin-bottom: 1rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  
  .description {
    color: #cbd5e1;
    line-height: 1.6;
    max-width: 380px;
    margin-bottom: 2rem; /* Space between text and contact info */
  }

  /* --- NEW CONTACT STYLES --- */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.1rem;
  }

  .label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #38bdf8; /* Accent Color */
    background: rgba(56, 189, 248, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
    min-width: 60px; /* Aligns the values */
    text-align: center;
  }

  .value {
    color: white;
    font-weight: 500;
  }

  .phone-link {
    color: white;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }

  .phone-link:hover {
    color: #38bdf8;
  }
  /* -------------------------- */

  /* Section Headers */
  h4 {
    color: #94a3b8;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1.25rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    margin-bottom: 0.75rem;
  }

  a {
    color: white;
    text-decoration: none;
    transition: color 0.2s;
    font-size: 1.05rem;
  }

  /* Standard link hover (excluding bottom bar/credit) */
  .footer-col ul a:hover {
    color: #38bdf8;
    padding-left: 4px; /* subtle movement on hover */
  }

  /* Bottom Bar Styling */
  .bottom-bar {
    background-color: #0f172a;
    padding: 1.5rem 0;
    font-size: 0.9rem;
    color: #64748b;
  }

  .bottom-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .credit a {
    color: #94a3b8;
    font-weight: 600;
    font-size: 0.9rem;
  }
  
  .credit a:hover {
    color: #38bdf8;
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .bottom-container {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
    
    .contact-item {
        font-size: 1rem;
    }
  }
</style>