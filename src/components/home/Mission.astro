---
/* Mission.astro */
---

<section class="foundation-block">
  <div class="container split-layout">
    
    <div class="text-content animate-fade-up">
      <h2>
        At CLM, We Build On A<br/>
        <span class="highlight">Solid Foundation</span>
      </h2>
    </div>

    <div class="expertise-box animate-fade-up delay-100">
      <p class="intro-text">
          Established in <strong>2008</strong>, CLM began with the idea to provide <strong>earthwork and utility services</strong> to the public, private, commercial, municipal and oil and gas sectors.
          <br><br>
          Now <strong>over 17 years later</strong>, we have placed <strong>millions of feet of pipe</strong> and performed countless utility and earthwork projects across <strong>7 different states</strong>.
      </p>
    </div>

  </div>
</section>

<style>
  .foundation-block {
    background-color: #f6f6f6;
    color: #1e293b;
    padding: 6rem 0;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .split-layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
  }

  h2 {
    font-size: 4rem;
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
    margin: 0;
    color: #1e293b;
  }

  .highlight {
    color: #38bdf8; /* Brand Blue */
  }

  .expertise-box {
    max-width: 600px;
    border-left: 4px solid #38bdf8;
    padding-left: 2.5rem; 
  }

  .intro-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 0; 
  }

  /* --- Animation Classes --- */
  .animate-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .animate-fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .delay-100 {
    transition-delay: 0.1s;
  }

  /* --- Responsive --- */
  @media (max-width: 1200px) {
    h2 { font-size: 3rem; }
  }

  @media (max-width: 768px) {
    .foundation-block { padding: 4rem 0; }
    
    .split-layout {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
    
    .expertise-box {
        border-left: none;
        border-top: 4px solid #38bdf8;
        padding-left: 0;
        padding-top: 1.5rem;
    }
  }
</style>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.animate-fade-up').forEach((el) => {
    observer.observe(el);
  });
</script>