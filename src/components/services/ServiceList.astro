---
import { Image } from 'astro:assets';

const services = [
  {
    id: "01",
    title: "Civil",
    subtitle: "Civil Construction",
    slug: "civil",
    description: "We self-perform all facets of your civil construction project.",
    features: [
      "Excavation",
      "Subgrade Preparation",
      "Lime and Cement Stabilization",
      "Material Handling"
    ],
    img: "https://media.clmconstructionservices.com/services/s_1.webp"
  },
  {
    id: "02",
    title: "HDPE",
    subtitle: "Drainage Systems",
    slug: "drainage",
    description: "CLM Construction Services specializes in all aspects of HDPE installations across all material sectors.",
    features: [
      "Drainage Systems",
      "Domestic Water",
      "Sanitary Sewer",
      "Thermal Heating & Cooling"
    ],
    img: "https://media.clmconstructionservices.com/services/s_2.webp"
  },
  {
    id: "03",
    title: "Utility",
    subtitle: "Utility Infrastructure",
    slug: "utilities",
    description: "We install all features of utility infrastructure for services such as domestic water, sanitary sewer, and drainage.",
    features: [
      "Domestic Water Piping Systems",
      "Sanitary Sewer Systems and Lift Stations",
      "Storm Drain and Detention Facilities",
      "Repair and Replacement of Existing Utility Systems"
    ],
    img: "https://media.clmconstructionservices.com/services/s_3.webp"
  },
  {
    id: "04",
    title: "Earthwork",
    subtitle: "Earthwork Solutions",
    slug: "earthwork",
    description: "Our earthwork services serve a myriad of clients. From large scale institutions and commercial general contractors, to rural farm and ranch owners we seek to provide exceptional earthwork solutions.",
    features: [
      "Clearing and Grubbing",
      "Earthwork, Grading, and Compaction",
      "Site Preparation",
      "Paving, Subgrade, and Stabilization"
    ],
    img: "https://media.clmconstructionservices.com/services/s_4.webp"
  }
];
---

<section class="services-wrapper">
  
  {/* --- Intro Section --- */}
  <div class="services-intro">
    <div class="container">
      <div class="intro-content animate-fade-up">
        <h2>Our <span class="highlight">Services</span></h2>
        <p>
          Delivering comprehensive site solutions with precision and expertise. 
          From groundwork to utility infrastructure, we build the foundation for your success.
        </p>
        <div class="bar"></div>
      </div>
    </div>
  </div>

  {/* --- Service List --- */}
  <div class="services-list">
    {services.map((service, index) => (
      <div id={service.slug} class={`service-split ${index % 2 !== 0 ? 'reverse light-theme' : 'dark-theme'}`}>
        
        {/* Image Side */}
        <div class="image-side">
          <Image 
            src={service.img} 
            alt={service.title} 
            width={1200} 
            height={900} 
            class="cover-img"
          />
          <div class="img-overlay"></div>
        </div>

        {/* Text Side */}
        <div class="text-side">
          <div class="content animate-fade-up">
            <div class="header-group">
              <span class="id-number">{service.id}</span>
              <h2 class="title">{service.title}</h2>
            </div>
            
            <span class="subtitle">{service.subtitle}</span>
            <div class="divider"></div>
            
            <p class="description">{service.description}</p>
            
            <ul class="feature-list">
              {service.features.map(item => (
                <li>
                  <i class="fi fi-rs-check-circle check-icon"></i>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

      </div>
    ))}
  </div>
</section>

<style>
  .services-wrapper {
    width: 100%;
    background-color: white;
  }

  /* --- Intro Styles --- */
  .services-intro {
    padding: 6rem 0 4rem 0;
    text-align: center;
    background-color: white;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .intro-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .services-intro h2 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-primary);
    line-height: 1.1;
    margin: 0;
  }

  .highlight {
    color: var(--color-accent);
  }

  .services-intro p {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-main);
    margin: 0;
  }

  .bar {
    width: 80px;
    height: 6px;
    background-color: var(--color-accent);
    margin-top: 1rem;
    border-radius: 3px;
  }

  /* --- Service Split Layout --- */
  .services-list {
    width: 100%;
    overflow: hidden;
  }

  .service-split {
    display: flex;
    min-height: 600px; 
    width: 100%;
    position: relative;
    scroll-margin-top: 100px; 
  }

  .service-split.reverse {
    flex-direction: row-reverse;
  }

  /* --- Image Side --- */
  .image-side {
    flex: 1;
    width: 50%;
    position: relative;
    overflow: hidden;
    min-height: 500px; 
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s ease;
  }

  .img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(27, 58, 105, 0.2), transparent);
    pointer-events: none;
  }

  /* --- Text Side Base --- */
  .text-side {
    flex: 1;
    width: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 4rem; 
    position: relative;
  }

  .content {
    max-width: 650px;
    width: 100%;
  }

  /* --- DARK THEME (Odd Items: Civil, Utility) --- */
  .service-split.dark-theme .text-side {
    background-color: var(--color-primary); 
    background-image: linear-gradient(135deg, var(--color-primary) 0%, #0F203C 100%);
    color: white;
  }

  .service-split.dark-theme .id-number { color: rgba(255,255,255,0.2); }
  .service-split.dark-theme .title { color: white; }
  .service-split.dark-theme .description { color: #cbd5e1; }
  .service-split.dark-theme .feature-list li { 
    color: #e2e8f0; 
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  /* --- LIGHT THEME (Even Items: HDPE, Earthwork) --- */
  .service-split.light-theme .text-side {
    background-color: #f8fafc; /* Very light gray/white */
    color: var(--color-primary);
  }

  .service-split.light-theme .id-number { color: rgba(27, 58, 105, 0.15); }
  .service-split.light-theme .title { color: var(--color-primary); }
  .service-split.light-theme .description { color: var(--color-text-main); }
  .service-split.light-theme .feature-list li { 
    color: var(--color-primary); 
    border-bottom: 1px solid rgba(27, 58, 105, 0.1);
  }

  /* --- Common Text Styles --- */
  .header-group {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .id-number {
    font-size: 1.25rem;
    font-weight: 700;
    font-family: 'Barlow', sans-serif;
  }

  .title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
  }

  .subtitle {
    display: block;
    font-size: 1.1rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .divider {
    width: 60px;
    height: 4px;
    background-color: var(--color-accent);
    margin-bottom: 2rem;
    border-radius: 2px;
  }

  .description {
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    font-weight: 400;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem 2rem;
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
    padding-bottom: 1rem;
  }

  .check-icon {
    color: var(--color-accent);
    font-size: 1.1rem;
    margin-top: 2px;
  }

  /* --- Animations --- */
  .animate-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .animate-fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Hover Effects --- */
  .service-split:hover .cover-img {
    transform: scale(1.03);
  }

  /* --- Responsive Breakpoints --- */
  @media (max-width: 992px) {
    .services-intro {
      padding: 4rem 0 2rem 0;
    }

    .service-split,
    .service-split.reverse {
      flex-direction: column;
      min-height: auto;
    }

    .image-side, .text-side {
      width: 100%;
      flex: none;
    }

    .image-side {
      height: 350px;
    }

    .text-side {
      padding: 3rem 1.5rem;
    }

    .title {
      font-size: 2.5rem;
    }
    
    .feature-list {
        grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.animate-fade-up').forEach((el) => {
    observer.observe(el);
  });
</script>