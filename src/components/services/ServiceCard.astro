---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  subtitle: string;
  slug: string;
  description: string;
  features: string[];
  img: string;
  index: number;
}

const { id, title, subtitle, slug, description, features, img, index } = Astro.props;

/* Layout Logic */
const isOdd = index % 2 !== 0;
const layoutClass = isOdd ? 'reverse' : '';
const themeClass = isOdd ? 'light-theme' : 'dark-theme';
---

<div id={slug} class={`service-split ${layoutClass} ${themeClass}`}>
  
  {/* --- IMAGE SIDE --- */}
  <div class="image-side">
    <Image 
      src={img} 
      alt={title} 
      width={1200} 
      height={900} 
      class="cover-img"
    />
    {/* Overlay restored at 5% opacity */}
    <div class="img-overlay"></div>
  </div>

  {/* --- TEXT SIDE --- */}
  <div class="text-side">
    <div class="content animate-fade-up">
      <div class="header-group">
        <span class="id-number">{id}</span>
        <h2 class="title">{title}</h2>
      </div>
      
      <span class="subtitle">{subtitle}</span>
      <div class="divider"></div>
      
      <p class="description">{description}</p>
      
      <ul class="feature-list">
        {features.map(item => (
          <li>
            <i class="fi fi-rs-check-circle check-icon"></i>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

</div>

<style>
  /* ----------------------- */
  /* Layout                  */
  /* ----------------------- */
  .service-split {
    display: flex;
    min-height: 600px; 
    width: 100%;
    position: relative;
    scroll-margin-top: 100px;
    overflow: hidden;
  }

  .service-split.reverse {
    flex-direction: row-reverse;
  }

  /* ----------------------- */
  /* Image Side              */
  /* ----------------------- */
  .image-side {
    flex: 1;
    width: 50%;
    position: relative;
    min-height: 500px;
    overflow: hidden; 
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s ease;
    position: relative;
    z-index: 1;
  }

  .service-split:hover .cover-img {
    transform: scale(1.03);
  }

  /* OVERLAY: 5% Navy Opacity */
  .img-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(27, 58, 105, 0.05); /* 0.05 = 5% */
    pointer-events: none;
    z-index: 2;
  }

  /* ----------------------- */
  /* Text Side & Decorations */
  /* ----------------------- */
  .text-side {
    flex: 1;
    width: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 4rem; 
    position: relative;
    isolation: isolate; 
  }

  /* PSEUDO-ELEMENTS: Dashed Lines */
  .text-side::before,
  .text-side::after {
    content: ""; 
    position: absolute;
    opacity: 0.2; /* Line opacity remains 20% */
    pointer-events: none;
    z-index: 1; 
  }

  /* 1. Vertical Line (::before) */
  .text-side::before {
    top: 0;
    bottom: 0;
    width: 0; 
    border-left: 3px dashed var(--color-accent);
  }

  /* 2. Horizontal Line (::after) */
  .text-side::after {
    top: 25%;
    width: 150px;
    height: 0; 
    border-top: 3px dashed var(--color-accent);
  }

  /* --- Positioning Logic --- */
  .service-split:not(.reverse) .text-side::before { right: 4rem; }
  .service-split:not(.reverse) .text-side::after  { left: 0; }

  .service-split.reverse .text-side::before { left: 4rem; }
  .service-split.reverse .text-side::after  { right: 0; }


  /* ----------------------- */
  /* Content Styling         */
  /* ----------------------- */
  .content {
    max-width: 650px;
    width: 100%;
    position: relative;
    z-index: 2; 
  }

  .header-group {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .id-number {
    font-size: 1.25rem;
    font-weight: 700;
    font-family: 'Barlow', sans-serif;
  }

  .title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
  }

  .subtitle {
    display: block;
    font-size: 1.1rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .divider {
    width: 60px;
    height: 4px;
    background-color: var(--color-accent);
    margin-bottom: 2rem;
    border-radius: 2px;
  }

  .description {
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    font-weight: 400;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem 2rem;
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
    padding-bottom: 1rem;
  }

  .check-icon {
    color: var(--color-accent);
    font-size: 1.1rem;
    margin-top: 2px;
  }

  /* ----------------------- */
  /* Themes                  */
  /* ----------------------- */
  
  /* Dark Theme */
  .service-split.dark-theme .text-side {
    background-color: var(--color-primary); 
    /* Gradient removed. Now a flat solid color. */
    background-image: none;
    color: white;
  }
  .service-split.dark-theme .id-number { color: rgba(255,255,255,0.2); }
  .service-split.dark-theme .title { color: white; }
  .service-split.dark-theme .description { color: #cbd5e1; }
  .service-split.dark-theme .feature-list li { 
    color: #e2e8f0; 
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  /* Light Theme */
  .service-split.light-theme .text-side {
    background-color: #f8fafc; 
    color: var(--color-primary);
  }
  .service-split.light-theme .id-number { color: rgba(27, 58, 105, 0.15); }
  .service-split.light-theme .title { color: var(--color-primary); }
  .service-split.light-theme .description { color: var(--color-text-main); }
  .service-split.light-theme .feature-list li { 
    color: var(--color-primary); 
    border-bottom: 1px solid rgba(27, 58, 105, 0.1);
  }

  /* ----------------------- */
  /* Animations & Responsive */
  /* ----------------------- */
  .animate-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .animate-fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 992px) {
    .service-split,
    .service-split.reverse {
      flex-direction: column;
      min-height: auto;
    }

    .image-side, .text-side {
      width: 100%;
      flex: none;
    }

    .image-side {
      height: 350px;
    }

    .text-side {
      padding: 3rem 1.5rem;
    }

    .title {
      font-size: 2.5rem;
    }
    
    .feature-list {
      grid-template-columns: 1fr;
    }

    .text-side::before,
    .text-side::after {
      display: none;
    }
  }
</style>